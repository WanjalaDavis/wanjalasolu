<%- include('../partials/header', {title:'Manage Portfolio'}) %><%- include('../partials/messages') %>
<section class="section-pad"><div class="container"><div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow">ADMINISTRATION</div><h1 class="display-heading">Portfolio</h1></div><a href="/admin" class="btn btn-outline-light">Dashboard</a></div>
<div class="form-panel mb-4"><h4>Add a project</h4><form method="POST" action="/admin/portfolio" enctype="multipart/form-data" class="row g-3"><div class="col-md-6"><label class="form-label">Project title</label><input class="form-control" name="title" required></div><div class="col-md-6"><label class="form-label">Category</label><input class="form-control" name="category" required placeholder="Website, Branding, Networking..."></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="2"></textarea></div><div class="col-md-6"><label class="form-label">Project URL (optional)</label><input class="form-control" name="project_url" type="url" placeholder="https://"></div><div class="col-md-6"><label class="form-label">Preview image (JPG, PNG, WEBP; max <%= process.env.MAX_UPLOAD_MB || 5 %>MB)</label><input class="form-control" type="file" name="image" accept="image/png,image/jpeg,image/webp"></div><div class="col-12"><button class="btn btn-orange">Add project</button></div></form></div>
<div class="row g-3"><% projects.forEach(p => { %><div class="col-md-4"><div class="service-card h-100"><% if (p.image) { %><img src="<%= p.image %>" class="img-fluid rounded mb-3" alt="<%= p.title %>"><% } %><small class="text-orange"><%= p.category %></small><h5 class="mt-2"><%= p.title %></h5><p class="text-secondary"><%= p.description || '' %></p><form method="POST" action="/admin/portfolio/<%= p.id %>/delete" onsubmit="return confirm('Delete this project?')"><button class="btn btn-sm btn-outline-danger">Delete project</button></form></div></div><% }) %></div></div></section><%- include('../partials/footer') %>