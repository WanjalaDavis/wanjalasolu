<%- include('../partials/header', {title:'Admin Dashboard'}) %><%- include('../partials/messages') %>
<section class="section-pad"><div class="container"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><div class="eyebrow">ADMINISTRATION</div><h1 class="display-heading">Dashboard</h1><p class="text-secondary mb-0">Welcome, <%= admin.name %>.</p></div><form method="POST" action="/admin/logout"><button class="btn btn-outline-light">Sign out</button></form></div>
<div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="stat-card"><small>Total enquiries</small><strong><%= counts.total_enquiries %></strong></div></div><div class="col-6 col-lg-3"><div class="stat-card"><small>New enquiries</small><strong><%= counts.new_enquiries %></strong></div></div><div class="col-6 col-lg-3"><div class="stat-card"><small>Active services</small><strong><%= counts.active_services %></strong></div></div><div class="col-6 col-lg-3"><div class="stat-card"><small>Portfolio projects</small><strong><%= counts.projects %></strong></div></div></div>
<div class="d-flex flex-wrap gap-2 mb-4"><a class="btn btn-orange" href="/admin/enquiries">Manage enquiries</a><a class="btn btn-outline-light" href="/admin/services">Manage services</a><a class="btn btn-outline-light" href="/admin/portfolio">Manage portfolio</a></div>
<div class="table-responsive admin-table"><table class="table table-dark table-hover align-middle"><thead><tr><th>Client</th><th>Subject</th><th>Status</th><th>Date</th></tr></thead><tbody><% recent.forEach(item => { %><tr><td><%= item.full_name %><br><small class="text-secondary"><%= item.email %></small></td><td><%= item.subject %></td><td><span class="status-pill"><%= item.status %></span></td><td><%= new Date(item.created_at).toLocaleDateString() %></td></tr><% }) %><% if (!recent.length) { %><tr><td colspan="4" class="text-center text-secondary">No enquiries yet.</td></tr><% } %></tbody></table></div>
</div></section><%- include('../partials/footer') %>