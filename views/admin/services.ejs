<%- include('../partials/header', {title:'Manage Services'}) %><%- include('../partials/messages') %>
<section class="section-pad"><div class="container"><div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow">ADMINISTRATION</div><h1 class="display-heading">Services</h1></div><a href="/admin" class="btn btn-outline-light">Dashboard</a></div>
<div class="form-panel mb-4"><h4>Add a service</h4><form method="POST" action="/admin/services" class="row g-3"><div class="col-md-6"><label class="form-label">Title</label><input class="form-control" name="title" required></div><div class="col-md-6"><label class="form-label">Category</label><input class="form-control" name="category" required placeholder="e.g. Web Development"></div><div class="col-12"><label class="form-label">Short description</label><input class="form-control" name="short_description" maxlength="255" required></div><div class="col-12"><label class="form-label">Full description</label><textarea class="form-control" name="description" rows="3" required></textarea></div><div class="col-md-6"><label class="form-label">Bootstrap icon class</label><input class="form-control" name="icon" value="bi-stars"></div><div class="col-md-6 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" name="is_featured" value="1" id="featured"><label class="form-check-label" for="featured">Feature on homepage</label></div></div><div class="col-12"><button class="btn btn-orange">Add service</button></div></form></div>
<div class="table-responsive admin-table"><table class="table table-dark table-hover"><thead><tr><th>Service</th><th>Category</th><th>Visibility</th><th>Action</th></tr></thead><tbody><% services.forEach(s => { %><tr><td><strong><%= s.title %></strong><br><small class="text-secondary"><%= s.short_description %></small></td><td><%= s.category %></td><td><%= s.is_active ? 'Active' : 'Hidden' %></td><td><form method="POST" action="/admin/services/<%= s.id %>/toggle"><button class="btn btn-sm btn-outline-light"><%= s.is_active ? 'Hide' : 'Activate' %></button></form></td></tr><% }) %></tbody></table></div></div></section><%- include('../partials/footer') %>