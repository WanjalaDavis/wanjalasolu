<%- include('../partials/header', {title:'Manage Enquiries'}) %><%- include('../partials/messages') %>
<section class="section-pad"><div class="container"><div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow">ADMINISTRATION</div><h1 class="display-heading">Enquiries</h1></div><a href="/admin" class="btn btn-outline-light">Dashboard</a></div>
<div class="table-responsive admin-table"><table class="table table-dark table-hover align-middle"><thead><tr><th>Client</th><th>Request</th><th>Message</th><th>Status</th><th>Date</th></tr></thead><tbody>
<% enquiries.forEach(e => { %><tr><td><strong><%= e.full_name %></strong><br><a href="mailto:<%= e.email %>"><%= e.email %></a><br><small><%= e.phone || '' %></small></td><td><%= e.service_title || 'General' %><br><small><%= e.subject %></small></td><td class="message-cell"><%= e.message %></td><td><form method="POST" action="/admin/enquiries/<%= e.id %>/status"><select name="status" class="form-select form-select-sm" onchange="this.form.submit()"><% ['New','In Progress','Completed','Archived'].forEach(s => { %><option <%= e.status===s?'selected':'' %>><%= s %></option><% }) %></select></form></td><td><%= new Date(e.created_at).toLocaleString() %></td></tr><% }) %>
<% if (!enquiries.length) { %><tr><td colspan="5" class="text-center text-secondary">No enquiries received.</td></tr><% } %></tbody></table></div></div></section><%- include('../partials/footer') %>