<%- include('partials/header', {title:service.title}) %>
<section class="page-hero"><div class="container"><div class="eyebrow"><%= service.category %></div><h1><%= service.title %></h1><p><%= service.short_description %></p></div></section>
<section class="section-pad"><div class="container"><div class="row g-5"><div class="col-lg-8"><div class="service-detail-icon"><i class="bi <%= service.icon %>"></i></div><h2 class="mt-4">How we can help</h2><p class="text-secondary lead"><%= service.description %></p><p class="text-secondary">Contact us with your requirements so we can understand your needs, confirm the scope and advise on the next steps.</p></div><div class="col-lg-4"><div class="contact-panel"><h4>Need this service?</h4><p class="text-secondary">Tell us what you have in mind and request a quote.</p><a href="/request?service=<%= service.id %>" class="btn btn-orange w-100">Request this service</a><% if (business.whatsapp) { %><a href="<%= whatsappLink('Hello Wanjala Solutions. I am interested in ' + service.title + '.') %>" target="_blank" rel="noopener" class="btn btn-outline-light w-100 mt-2"><i class="bi bi-whatsapp me-2"></i>WhatsApp us</a><% } %></div></div></div></div></section>
<%- include('partials/footer') %>
