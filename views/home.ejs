<%- include('partials/header', {title:'Digital Solutions & Cyber Services'}) %>
  <section class="hero-section">
    <div class="container py-5">
      <div class="row align-items-center min-vh-hero g-5">
        <div class="col-lg-7">
          <div class="eyebrow"><span></span> YOUR TRUSTED DIGITAL PARTNER</div>
          <h1 class="hero-title mt-3">Your Digital World,<br><span>Simplified.</span></h1>
          <p class="hero-copy mt-4">From powerful websites and creative designs to online application assistance and
            reliable IT networking — we help turn your digital needs into practical solutions.</p>
          <div class="d-flex flex-wrap gap-3 mt-4">
            <a href="/services" class="btn btn-orange btn-lg">Explore our services <i
                class="bi bi-arrow-up-right ms-2"></i></a>
            <a href="/request" class="btn btn-outline-light btn-lg">Get a quote</a>
          </div>
          <div class="hero-trust mt-5"><span><i class="bi bi-check-circle-fill"></i> Professional service</span><span><i
                class="bi bi-check-circle-fill"></i> Customer focused</span><span><i
                class="bi bi-check-circle-fill"></i> Practical solutions</span></div>
        </div>
        <div class="col-lg-5">
          <div class="hero-visual">
            <div class="visual-orbit orbit-one"></div>
            <div class="visual-orbit orbit-two"></div>
            <div class="visual-core">
              <img src="/images/logo.png" alt="Wanjala Solutions Logo" class="hero-logo">
         </div>
            <div class="floating-chip chip-one"><i class="bi bi-code-slash"></i> Web Development</div>
            <div class="floating-chip chip-two"><i class="bi bi-palette"></i> Creative Design</div>
            <div class="floating-chip chip-three"><i class="bi bi-router"></i> Networking</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">WHAT WE DO</div>
        <h2>Solutions built around <span>your needs.</span></h2>
        <p>One reliable destination for your digital, creative and technology needs.</p>
      </div>
      <div class="row g-4 mt-2">
        <% services.forEach(service=> { %>
          <div class="col-md-6 col-xl-4">
            <div class="service-card h-100">
              <div class="service-icon"><i class="bi <%= service.icon %>"></i></div>
              <div class="small text-orange fw-semibold mb-2">
                <%= service.category %>
              </div>
              <h5>
                <%= service.title %>
              </h5>
              <p>
                <%= service.short_description %>
              </p><a href="/services/<%= service.slug %>" class="text-link">Explore service <i
                  class="bi bi-arrow-up-right"></i></a>
            </div>
          </div>
          <% }) %>
      </div>
      <div class="text-center mt-5"><a href="/services" class="btn btn-outline-light">View all services <i
            class="bi bi-arrow-right ms-2"></i></a></div>
    </div>
  </section>

  <section class="section-pad section-muted">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
          <div class="eyebrow">WHY WANJALA SOLUTIONS</div>
          <h2 class="display-heading mt-3">Technology should make life <span>easier.</span></h2>
          <p class="text-secondary mt-3">We bring together technical skills, creativity and a customer-first approach to
            help people and organisations get things done.</p>
          <ul class="check-list mt-4">
            <li>Clear communication from enquiry to delivery</li>
            <li>Solutions designed around your requirements</li>
            <li>Support for individuals, startups and established businesses</li>
            <li>Commitment to quality, privacy and professionalism</li>
          </ul>
          <a href="/about" class="btn btn-orange mt-3">More about us</a>
        </div>
        <div class="col-lg-6">
          <div class="feature-panel">
            <div class="feature-panel-top"><span class="dot"></span><span class="dot"></span><span
                class="dot"></span><small>WANJALA / SOLUTIONS</small></div>
            <div class="feature-panel-body">
              <div class="feature-code">01 <span>CREATE</span></div>
              <div class="feature-code">02 <span>CONNECT</span></div>
              <div class="feature-code">03 <span>SIMPLIFY</span></div>
              <div class="feature-message">Ideas into <b>digital impact.</b><span>CODE. BUILD. INNOVATE.</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <% if (projects.length) { %>
    <section class="section-pad">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow">SELECTED WORK</div>
          <h2>Our recent <span>projects.</span></h2>
        </div>
        <div class="row g-4 mt-2">
          <% projects.forEach(project=> { %><div class="col-md-4">
              <div class="project-card h-100">
                <% if (project.image) { %><img src="<%= project.image %>" alt="<%= project.title %>">
                  <% } else { %>
                    <div class="project-placeholder"><i class="bi bi-window"></i></div>
                    <% } %>
                      <div class="p-4"><small class="text-orange">
                          <%= project.category %>
                        </small>
                        <h5 class="mt-2">
                          <%= project.title %>
                        </h5>
                        <p class="text-secondary">
                          <%= project.description || '' %>
                        </p>
                        <% if (project.project_url) { %><a class="text-link" href="<%= project.project_url %>"
                            target="_blank" rel="noopener">View project <i class="bi bi-arrow-up-right"></i></a>
                          <% } %>
                      </div>
              </div>
            </div>
            <% }) %>
        </div>
        <div class="text-center mt-4"><a href="/portfolio" class="btn btn-outline-light">View portfolio</a></div>
      </div>
    </section>
    <% } %>

      <section class="cta-section">
        <div class="container text-center py-5">
          <div class="eyebrow justify-content-center">LET'S WORK TOGETHER</div>
          <h2 class="mt-3">Have a project or need a service?</h2>
          <p class="text-secondary">Tell us what you need. We will be glad to help.</p><a href="/request"
            class="btn btn-orange btn-lg mt-2">Start an enquiry <i class="bi bi-arrow-right ms-2"></i></a>
        </div>
      </section>
      <%- include('partials/footer') %>